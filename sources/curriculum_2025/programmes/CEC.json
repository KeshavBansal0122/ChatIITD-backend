  "outcomes": [
    {
      "outcome_id": "PLO1",
      "text": "Acquire specialized knowledge in Construction Engineering, Technology and Management, including expertise in emerging technologies, materials, and industry trends."
    },
    {
      "outcome_id": "PLO2",
      "text": "Apply critical thinking and analytical skills to conceptualize, evaluate, and manage construction projects while considering technical, environmental, financial, and socio- economic factors."
    },
    {
      "outcome_id": "PLO3",
      "text": "Conduct independent research and develop innovative and sustainable solutions for challenges in construction project management and engineering including risk management, resource optimization, digital construction, and financial management."
    },
    {
      "outcome_id": "PLO4",
      "text": "Communicate effectively and ethically with diverse stakeholders, demonstrating leadership, teamwork, and professional integrity in construction and infrastructure development."
    }
  ],

  "outcomes": [
    {
      "outcome_id": "PLO1",
      "text": "Isolate and synthesize chemical compounds and materials relevant to industries including pharmaceuticals, renewable energy, petrochemicals, and textile, among others; subject them to different separation and purification techniques."
    },
    {
      "outcome_id": "PLO2",
      "text": "Analyse these diverse range of chemical compounds and materials using state-of-the art analytical methods and techniques."
    },
    {
      "outcome_id": "PLO3",
      "text": "Relate the manufacturing processes, the structure, and the properties with that of synthesized chemicals and materials and be able to tune their properties and components accordingly."
    },
    {
      "outcome_id": "PLO4",
      "text": "Inspect, interpret, and validate the accuracy and reliability of analytical data and implementation of analytical methods for Quality Management and Control."
    }
  ],

  "outcomes": [
    {
      "outcome_id": "PLO1",
      "text": "Analyze and design structural systems (including steel, concrete, sustainable engineered materials, prestressed components) using advanced theoretical concepts, applications of artificial intelligence and machine learning, and computational methods."
    },
    {
      "outcome_id": "PLO2",
      "text": "Demonstrate scienquip students with geotechnical engineering fundamentals, laboratory and field skills, design and analysis skills, modern tools, and sustainable solutions for civil engineering applications.tific temperament, integrity, personal and professional responsibility, and respect for others."
    },
    {
      "outcome_id": "PLO3",
      "text": "Comprehend fundamental concepts, analyze key issues, design and manage water systems, develop understanding on climate change, acquaintance with modern tools such as remote sensing, geographic information systems, and integrating sustainability and ethical considerations in problem-solving."
    },
    {
      "outcome_id": "PLO4",
      "text": "Develop proficiency in scientific, analytical, and technical approaches to evaluate, monitor, and mitigate environmental pollution while incorporating sustainable solutions, regulatory policies, introducing advanced surveying techniques, and climate adaptation strategies to enhance environmental health and sustainability."
    },
    {
      "outcome_id": "PLO5",
      "text": "Understand fundamentals of highway materials and design and planning of transportation systems, introducing data analytics tools."
    },
    {
      "outcome_id": "PLO6",
      "text": "Enable to appraise, plan and schedule civil engineering projects and be acquainted with the latest construction practices and introduce automation using advanced robotics and applications of unmanned aerial vehicles in civil engineering."
    }
  ],

  "outcomes": [
    {
      "outcome_id": "PLO1",
      "text": "Be able to use the principles of conservation to design, develop and analyze mechanical engineering systems to address industry and society needs."
    },
    {
      "outcome_id": "PLO2",
      "text": "Demonstrate skills to model mechanical engineering systems to facilitate their design for safe, efficient and sustainable operation."
    },
    {
      "outcome_id": "PLO3",
      "text": "Demonstrate the ability to use mechanical engineering skills to address interdisciplinary technological problems."
    },
    {
      "outcome_id": "PLO4",
      "text": "Be able to design effective man-machine interfaces."
    },
    {
      "outcome_id": "PLO5",
      "text": "Possess the ethical awareness and reasoning skills to consider the societal and environmental impact of engineering solutions."
    }
  ],

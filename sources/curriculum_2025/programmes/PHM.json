  "outcomes": [
    {
      "outcome_id": "PLO1",
      "text": "Explain fundamental physical and technical basis of Solid-State Materials including energy materials, thin films and semiconductor device technology, nanostructures, etc."
    },
    {
      "outcome_id": "PLO2",
      "text": "Handle instruments independently like vacuum and cryogenics as well as advanced characterization tools and develop hands on knowledge."
    },
    {
      "outcome_id": "PLO3",
      "text": "Describe thebasics of quantum materials including hetrostructures, Spintronics, topology, Superconductivity, etc."
    },
    {
      "outcome_id": "PLO4",
      "text": "Analyse results, simulate outcomes, implement protocols to perform high-end experiments, and present them as reports/publications and oral presentations."
    },
    {
      "outcome_id": "PLO5",
      "text": "Outline new advanced scientific experimentsin emerging areas of electronic and Quantum Materials and their use in practical applications."
    },
    {
      "outcome_id": "PLO6",
      "text": "Demonstrate team as well as independent researcher\u2019s capabilities as the institute as well as industry level."
    }
  ],

  "outcomes": [
    {
      "outcome_id": "PLO1",
      "text": "In-depth understanding of core computer science principles., and working knowledge about cutting edge topics. Understanding of mathematical and logical foundations of computing; abstraction and reduction; data and its integrity, security and privacy; organisation of computing systems, supporting the design of efficient, secure, and reliable computing solutions."
    },
    {
      "outcome_id": "PLO2",
      "text": "Ability to identify, formulate, and analyze complex computational problems, driving effective problem-solving and innovation."
    },
    {
      "outcome_id": "PLO3",
      "text": "Expertise in programming and software development, leveraging modern languages, frameworks, and platforms."
    },
    {
      "outcome_id": "PLO4",
      "text": "Awareness of the ethical, societal, and environmental implications of computing technologies, and the role of computer science in interdisciplinary domains. Effective communication and teamwork skills, and application of ethical and societal values, fostering responsible and collaborative work ethics."
    }
  ],

  "outcomes": [
    {
      "outcome_id": "PLO1",
      "text": "Solve industry-relevant problems in microelectronics, microwave engineering and data science &amp; signal processing."
    },
    {
      "outcome_id": "PLO2",
      "text": "Design and measure multiple aspects of wireless and other electronic systems."
    },
    {
      "outcome_id": "PLO3",
      "text": "Design both active and passive circuits for high frequency defense, commercial, and societal applications. Graduate will also be able to utilize the concepts in the rapidly developing field of bio- electromagnetics."
    },
    {
      "outcome_id": "PLO4",
      "text": "Design high-frequency semiconductor devices and circuits, focusing on their applications in commercial, societal, and strategic domains."
    },
    {
      "outcome_id": "PLO5",
      "text": "Apply their knowledge in data science and signal processing systems/algorithms to practical problems."
    }
  ],

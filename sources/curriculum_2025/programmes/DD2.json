  "outcomes": [
    {
      "outcome_id": "PLO1",
      "text": "Develop core design and technical competencies to analyse problems as well as synthesize and communicate solutions"
    },
    {
      "outcome_id": "PLO2",
      "text": "Demonstrate scientific temperament, integrity, personal and professional responsibility, and empathy for human beings and other species on this planet"
    },
    {
      "outcome_id": "PLO3",
      "text": "Identify, analyse and solve challenging, ill-defined/wicked problems in the socio-technical systems using the design process within and across disciplines"
    },
    {
      "outcome_id": "PLO4",
      "text": "Apply their creative, research and analytical abilities to design sustainable, scalable and ethical solutions to issues of societal concern"
    }
  ],

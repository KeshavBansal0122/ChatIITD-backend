    },
    {
      "outcome_id": "PLO2",
      "text": "Demonstrate skills to design a safe, efficient and sustainable manufacturing system to address a production need."
    },
    {
      "outcome_id": "PLO3",
      "text": "Demonstrate the ability to use production and industrial engineering skills to address interdisciplinary technological problems."
    },
    {
      "outcome_id": "PLO4",
      "text": "Possess the ethical awareness and reasoning skills to consider the societal and environmental impact of manufacturing and industrial engineering solutions."
    }

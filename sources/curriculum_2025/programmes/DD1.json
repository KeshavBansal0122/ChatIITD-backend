      "outcome_id": "PLO1",
      "text": "BDes graduates will effectively design and communicate human-centred and sustainable solutions."
    },
    {
      "outcome_id": "PLO2",
      "text": "BDes graduates will be proficient in a variety of hands-on design tools and techniques needed towards solving real-world problems."
    },
    {
      "outcome_id": "PLO3",
      "text": "BDes graduates will be prepared to engage and be adept in professional design practice and leadership roles."
    },
    {
      "outcome_id": "PLO4",
      "text": "BDes graduates will demonstrate a strong understanding of research, design principles and design methodologies."
    }

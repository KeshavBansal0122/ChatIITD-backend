  "outcomes": [
    {
      "outcome_id": "PLO1",
      "text": "Graduates will develop a broad and interdisciplinary understanding of different classes of materials, their properties, and applications, enabling their selection and design for diverse engineering and scientific challenges."
    },
    {
      "outcome_id": "PLO2",
      "text": "Graduates will gain hands-on expertise in the synthesis, processing, and characterization of materials, applying experimental and computational techniques to solve practical problems."
    },
    {
      "outcome_id": "PLO3",
      "text": "Graduates will apply their knowledge to analyze and address complex challenges in industries such as chemical, petrochemical, plastics, metallurgy, electronics, and related sectors, contributing to innovation and sustainable solutions."
    },
    {
      "outcome_id": "PLO4",
      "text": "Graduates will communicate technical concepts effectively through written reports, presentations, and discussions, while collaborating in multidisciplinary teams to solve real- world engineering and scientific problems."
    },
    {
      "outcome_id": "PLO5",
      "text": "Graduates will demonstrate ethical responsibility, professional integrity, and awareness of environmental and societal implications in materials research, development, and industrial applications."
    }
  ],

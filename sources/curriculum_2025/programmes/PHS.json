  "outcomes": [
    {
      "outcome_id": "PLO1",
      "text": "Describe some of the key concepts of physics viz. Classical mechanics, Quantum mechanics, Solid state physics, Optics and photonics, Electronics, etc."
    },
    {
      "outcome_id": "PLO2",
      "text": "Handle important basic experiments as well as advanced state-of- the art experimental instruments to develop hands on knowledge."
    },
    {
      "outcome_id": "PLO3",
      "text": "Analyse results and outcomes, implement protocols to perform cutting-edge experiments/simulation, and present them as reports/publications and oral presentations."
    },
    {
      "outcome_id": "PLO5",
      "text": "Outline new advanced cutting-edge experiments and theoretical understanding in emerging areas of physics viz. semi-conducting materials, quantum computation, quantum materials and their use in device physics."
    },
    {
      "outcome_id": "PLO6",
      "text": "Demonstrate team as well as independent researcher\u2019s capabilities at the institute as well as industry level."
    }
  ],

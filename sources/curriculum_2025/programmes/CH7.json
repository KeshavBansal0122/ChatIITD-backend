    },
    {
      "outcome_id": "PLO2",
      "text": "Use contemporary engineering tools and methods necessary for safe practices in chemical engineering."
    },
    {
      "outcome_id": "PLO3",
      "text": "Communicate effectively, embrace teamwork, and demonstrate integrity and leadership."
    },
    {

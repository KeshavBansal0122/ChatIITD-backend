  "outcomes": [
    {
      "outcome_id": "PLO1",
      "text": "Develop\u202c \u202dprecise\u202c \u202danalytical\u202c \u202dthinking\u202c \u202dand\u202c \u202deffectively\u202c \u202dcommunicate\u202c \u202dmathematical\u202c \u202dideas;\u202c \u202dcultivate\u202c\u202d robust\u202c\u202d logical\u202c\u202d reasoning\u202c\u202d and\u202c\u202d problem-solving\u202c\u202d abilities\u202c\u202d necessary\u202c\u202d for\u202c\u202d advanced\u202c\u202d mathematical\u202c \u202dstudy.\u202c"
    },
    {
      "outcome_id": "PLO2",
      "text": "Demonstrate\u202c \u202dthe\u202c \u202dability\u202c \u202dto\u202c \u202dindependently\u202c \u202dformulate,\u202c \u202danalyze,\u202c \u202dand\u202c \u202dsolve\u202c \u202dcomplex\u202c \u202dproblems\u202c \u202dusing\u202c \u202dappropriate\u202c \u202dmathematical\u202c \u202dtools,\u202c \u202dcomputational\u202c \u202dtechniques,\u202c \u202dor\u202c \u202dstatistical\u202c \u202dmethods\u202c \u202drelevant\u202c \u202dto\u202c \u202dtheir specialization.\u202c"
    },
    {
      "outcome_id": "PLO3",
      "text": "Recognize\u202c \u202dthe\u202c \u202dimpact\u202c \u202dof\u202c \u202dmathematics\u202c \u202din\u202c \u202dadvancing\u202c \u202dboth\u202c \u202dacademic\u202c \u202dinquiry\u202c \u202dand\u202c \u202dindustrial\u202c \u202dinnovation,\u202c \u202dand\u202c \u202ddevelop\u202c \u202dthe\u202c \u202dability\u202c \u202dto\u202c \u202dengage\u202c \u202dwith\u202c \u202dcurrent\u202c \u202ddevelopments\u202c \u202dand\u202c \u202dfuture\u202c \u202ddirections\u202c \u202din\u202c \u202dspecialized areas through sustained learning and research."
    }
  ],

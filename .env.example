# OpenRouter API Configuration (REQUIRED)
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model (Optional - defaults to openai/gpt-oss-120b:free)
# See available models at https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Qdrant Vector Database URL (Optional - defaults to http://localhost:6333)
# For Docker Compose: http://qdrant:6333
# For local development: http://localhost:6333
QDRANT_URL=http://localhost:6333

# Database URL (REQUIRED)
# For PostgreSQL (recommended): postgresql://chatiitd:chatiitd_dev@localhost:5432/chatiitd
# For SQLite (legacy): sqlite:///messages.db
DATABASE_URL=postgresql://chatiitd:chatiitd_dev@localhost:5432/chatiitd

# -----------------------------------------------------------------------------
# DevClub OIDC (https://auth.devclub.in/docs)
# Register a client and set redirect URIs exactly:
#   http://localhost:5173/callback
#   http://35.154.241.94/callback
# -----------------------------------------------------------------------------
CLIENT_ID=your_devclub_client_id_here
CLIENT_SECRET=your_devclub_client_secret_here
# Aliases also accepted: OIDC_CLIENT_ID / OIDC_CLIENT_SECRET

OIDC_DISCOVERY_URL=https://auth.devclub.in/api/oauth/.well-known/openid-configuration
OIDC_SCOPE=openid profile email hostel entry_number kerberos

# JWT we mint for the frontend after OAuth (REQUIRED in production)
JWT_SECRET=change-me-in-prod
JWT_EXP_MINUTES=1440

# Demo mode for testing (Optional - defaults to false)
# When enabled, accepts any token starting with "demo" for testing
DEMO_MODE=false

# Frontend URL(s) for CORS — comma-separated allowed
# Local Vite: http://localhost:5173
# Docker / prod via nginx: http://35.154.241.94
FRONTEND_URL=http://localhost:5173,http://35.154.241.94

# Backend URL as seen by clients (include /backend when behind nginx path prefix)
BACKEND_URL=http://localhost:8000

# Path prefix when reverse-proxied (empty for local direct access)
# Production nginx example: ROOT_PATH=/backend and BACKEND_URL=http://35.154.241.94/backend
ROOT_PATH=

# Admin portal at /admin (password gate; independent of OIDC user.role)
# Required for /portal/* API routes used by the frontend admin UI
ADMIN_PASSWORD=change-me-admin-password
# ADMIN_PORTAL_TOKEN_HOURS=12

# Guest device cookie (signed HttpOnly). Leave COOKIE_SECURE unset to auto-detect
# from the request scheme (required for http:// deploys / local Vite).
# DEVICE_ID_SECRET=
# COOKIE_SECURE=
# COOKIE_SAMESITE=lax

# Rate limits (uncached prompt + completion). One agent turn is often several thousand tokens.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_TOKENS=10000
# RATE_LIMIT_GUEST_TOKENS=20000
# RATE_LIMIT_WINDOW_HOURS=4
# RATE_LIMIT_BYOK_EXEMPT=true

# OpenRouter API Configuration (REQUIRED)
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# OpenRouter Model (Optional - defaults to openai/gpt-oss-120b:free)
# See available models at https://openrouter.ai/models
OPENROUTER_MODEL=openai/gpt-oss-120b:free

# Qdrant Vector Database URL (Optional - defaults to http://localhost:6333)
# For Docker Compose: http://qdrant:6333
# For local development: http://localhost:6333
QDRANT_URL=http://localhost:6333

# Database URL (REQUIRED)
# For PostgreSQL (recommended): postgresql://chatiitd:chatiitd_dev@localhost:5432/chatiitd
# For SQLite (legacy): sqlite:///messages.db
DATABASE_URL=postgresql://chatiitd:chatiitd_dev@localhost:5432/chatiitd

# JWT expiration time in minutes (Optional - defaults to 1440 = 24 hours)
JWT_EXP_MINUTES=1440

# DevClub OAuth Configuration (REQUIRED for authentication)
# Register your application at https://oauth.devclub.in/
# Get client_id and client_secret from the DevClub OAuth admin panel
CLIENT_ID=your_devclub_client_id_here
CLIENT_SECRET=your_devclub_client_secret_here

# JWT Secret for signing tokens (IMPORTANT: Change in production!)
JWT_SECRET=change-me-in-prod

# Demo mode for testing (Optional - defaults to false)
# When enabled, accepts any token starting with "demo" for testing
DEMO_MODE=false

# Frontend URL(s) for CORS — comma-separated allowed
# Local Vite: http://localhost:5173
# Docker frontend (frontend/docker-compose.yml): http://localhost:3000
FRONTEND_URL=http://localhost:5173,http://localhost:3000

# Backend URL
BACKEND_URL=http://localhost:8000
